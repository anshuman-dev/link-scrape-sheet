{
  "manifest_version": 3,
  "name": "Tab Exporter to Google Sheets",
  "version": "1.0.0",
  "description": "Export all open tabs to a new Google Sheet",
  "permissions": [
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://sheets.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "1007645605248-vk5ini2q6u80g3rp0ou0devtducu8cl9.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
